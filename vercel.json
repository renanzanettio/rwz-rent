{
  "framework": null,
  "outputDirectory": "public",
  "regions": ["gru1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/receipts/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/((?!receipts/|api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" }
      ]
    }
  ]
}
